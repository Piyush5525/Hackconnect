# Copy to .env (never commit .env). All values optional for local demo mode.
PORT=4173
# Set to true when served over HTTPS so session cookies get the Secure flag.
HACKCONNECT_SECURE_COOKIES=false
# demo (no key, free) | groq | gemini | openrouter | compatible (Ollama or any OpenAI-style server) | openai | anthropic
HACKCONNECT_AGENT_PROVIDER=demo
# Leave empty to use the provider's default model.
HACKCONNECT_AGENT_MODEL=
# Keys for provider=groq / gemini / openrouter (free tiers)
GROQ_API=
GEMINI_API=
OPENROUTER_API=

# --- Team hub: project channels, threads, handover and direct messages (https://nexconn.ai, free tier).
# App Key + App Secret from the Nexconn console. The secret stays on the server. Empty = the hub shows "not switched on".
NEXCONN_KEY=
NEXCONN_SECRET=
# Only for an app outside the default Singapore data center, e.g. api.us-light-api.com
NEXCONN_API_HOST=
# For provider=compatible. Ollama example: http://localhost:11434/v1 (key not needed)
HACKCONNECT_AGENT_BASE_URL=
HACKCONNECT_AGENT_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Sign in with Google / GitHub (free). See docs/ENVIRONMENT.md for the 5-minute setup.
# Public URL of this server, used for the OAuth callback. Local default: http://localhost:4173
HACKCONNECT_BASE_URL=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts stored GitHub tokens. If empty a key file is generated in .hackconnect/master.key
HACKCONNECT_MASTER_KEY=

# --- Email (free options: Gmail app password, Brevo free tier, a local Mailpit). Empty = local outbox mode:
# links are printed in the server window and saved in .hackconnect/outbox/
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=HackConnect <no-reply@example.com>
# true/false. Default: true when SMTP_HOST is set (unverified emails cannot sign in), false otherwise
HACKCONNECT_REQUIRE_VERIFIED=
# Minutes between automatic state backups (0 = off). Default 15; the newest 48 are kept in .hackconnect/backups
HACKCONNECT_AUTOBACKUP_MIN=15
